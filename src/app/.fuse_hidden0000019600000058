'use client';

import { useEffect, useState } from 'react';

// Site-wide loading screen (Next.js "loading.tsx" file convention) - the
// Suspense fallback shown while a route segment (and its data) is still
// loading. Before this there was no loading UI at all outside the
// homepage/articles/categories skeletons, so first navigation into
// /admin/*, /login, /register, /forgot-password, /complete-profile, etc.
// simply showed a blank white screen until everything was ready.
//
// The animation is a little stack of "pages" flipping in sequence -
// leafing through a newspaper - which fits "Les Pages Libres" more than a
// generic spinner would. If loading genuinely takes a while, a reassuring
// message fades in after a few seconds rather than leaving the visitor
// staring at an animation with no explanation.
export default function RootLoading() {
  const [showSlowNotice, setShowSlowNotice] = useState(false);

  useEffect(() => {
    const timer = setTimeout(() => setShowSlowNotice(true), 4500);
    return () => clearTimeout(timer);
  }, []);

  return (
    <div className="fixed inset-0 z-[100] flex flex-col items-center justify-center gap-8 bg-background">
      {/* Page-flip stack */}
      <div className="relative h-20 w-16 [perspective:600px]">
        <div className="absolute inset-0 rounded-md border-2 border-primary/20 bg-primary/5" />
        <div
          className="absolute inset-0 origin-left rounded-md border-2 border-primary/40 bg-primary/10 [transform-style:preserve-3d] animate-page-flip"
          style={{ animationDelay: '0s' }}
        />
        <div
          className="absolute inset-0 origin-left rounded-md border-2 border-primary/60 bg-primary/20 [transform-style:preserve-3d] animate-page-flip"
          style={{ animationDelay: '0.25s' }}
        />
        <div
          className="absolute inset-0 origin-left rounded-md border-2 border-primary bg-primary/30 [transform-style:preserve-3d] animate-page-flip"
          style={{ animationDelay: '0.5s' }}
        />
      </div>

      {/* Brand */}
      <div className="flex flex-col items-center gap-1">
        <div className="flex items-center gap-1.5 text-2xl font-bold">
          <span className="text-primary">Les Pages</span>
          <span className="text-secondary">Libres</span>
        </div>
        <p className="text-sm text-muted-foreground">Chargement en cours…</p>
      </div>

      {/* Progress bar */}
      <div className="h-1 w-48 overflow-hidden rounded-full bg-muted">
        <div className="h-full w-1/3 rounded-full bg-primary animate-loading-bar" />
      </div>

      {/* Reassurance message if it's taking a while */}
      <p
        className={`max-w-xs text-center text-xs text-muted-foreground transition-opacity duration-500 ${
          showSlowNotice ? 'opacity-100' : 'opacity-0'
        }`}
        aria-hidden={!showSlowNotice}
      >
        Cela prend un peu plus de temps que prévu. Merci de patienter, la page devrait s'afficher sous peu.
      </p>
    </div>
  );
}
