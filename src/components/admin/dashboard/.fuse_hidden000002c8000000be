'use client';

import { useEffect, useState } from 'react';
import Link from 'next/link';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogDescription,
} from '@/components/ui/dialog';
import { ChevronLeft, ChevronRight, FileText, ExternalLink } from 'lucide-react';
import { format, startOfMonth, endOfMonth, eachDayOfInterval, isSameMonth, isToday } from 'date-fns';
import { fr } from 'date-fns/locale';
import { cn } from '@/lib/utils';

interface ScheduledItem {
  id: string;
  title: string;
  date: Date;
  status: 'scheduled' | 'draft' | 'published';
}

const STATUS_LABEL: Record<ScheduledItem['status'], string> = {
  scheduled: 'Programmé',
  draft: 'Brouillon',
  published: 'Publié',
};

// The date shown per article depends on its status: a scheduled article's
// meaningful date is when it WILL publish, a published one is when it DID,
// and a draft has neither yet - created_at is the closest real date left.
function dateForArticle(row: any): Date | null {
  const iso = row.status === 'scheduled'
    ? row.scheduled_publish_at
    : row.status === 'published'
    ? row.published_at || row.created_at
    : row.created_at;
  if (!iso) return null;
  const d = new Date(iso);
  return isNaN(d.getTime()) ? null : d;
}

export function ContentCalendar() {
  const [currentDate, setCurrentDate] = useState(new Date());
  const [scheduledItems, setScheduledItems] = useState<ScheduledItem[]>([]);
  // Which day is open in the detail dialog - null when closed. Previously
  // a day's items were only visible as tiny truncated chips inside the
  // grid cell (with a "+N more" that did nothing), so anything past the
  // first couple of items on a busy day was simply not visible at all.
  const [selectedDay, setSelectedDay] = useState<Date | null>(null);

  useEffect(() => {
    let cancelled = false;
    // Real articles (scheduled/draft/published) instead of the hardcoded
    // 2024 placeholder dates this used to show.
    fetch('/api/articles?limit=100', { cache: 'no-store' })
      .then((res) => res.json())
      .then((data) => {
        if (cancelled) return;
        const items: ScheduledItem[] = (data.articles || [])
          .filter((row: any) => ['scheduled', 'draft', 'published'].includes(row.status))
          .map((row: any) => ({ id: row.id, title: row.title, date: dateForArticle(row), status: row.status }))
          .filter((item: any) => item.date !== null);
        setScheduledItems(items);
      })
      .catch(() => {
        if (!cancelled) setScheduledItems([]);
      });
    return () => {
      cancelled = true;
    };
  }, []);

  const monthStart = startOfMonth(currentDate);
  const monthEnd = endOfMonth(currentDate);
  const days = eachDayOfInterval({ start: monthStart, end: monthEnd });

  const getStatusColor = (status: ScheduledItem['status']) => {
    switch (status) {
      case 'scheduled':
        return 'bg-green-500';
      case 'draft':
        return 'bg-yellow-500';
      case 'published':
        return 'bg-blue-500';
      default:
        return 'bg-gray-500';
    }
  };

  const getItemsForDay = (day: Date) => {
    return scheduledItems.filter(
      (item) => format(item.date, 'yyyy-MM-dd') === format(day, 'yyyy-MM-dd')
    );
  };

  const selectedDayItems = selectedDay ? getItemsForDay(selectedDay) : [];

  return (
    <Card>
      <CardHeader className="flex flex-row items-center justify-between">
        <CardTitle>Calendrier de contenu</CardTitle>
        <div className="flex items-center gap-2">
          <Button
            variant="outline"
            size="icon"
            onClick={() => setCurrentDate(new Date(currentDate.setMonth(currentDate.getMonth() - 1)))}
          >
            <ChevronLeft className="h-4 w-4" />
          </Button>
          <span className="font-medium capitalize">
            {format(currentDate, 'MMMM yyyy', { locale: fr })}
          </span>
          <Button
            variant="outline"
            size="icon"
            onClick={() => setCurrentDate(new Date(currentDate.setMonth(currentDate.getMonth() + 1)))}
          >
            <ChevronRight className="h-4 w-4" />
          </Button>
        </div>
      </CardHeader>
      <CardContent>
        <div className="grid grid-cols-7 gap-1">
          {['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'].map((day) => (
            <div key={day} className="text-center text-xs font-medium text-muted-foreground py-2">
              {day}
            </div>
          ))}
          {days.map((day) => {
            const items = getItemsForDay(day);
            const isCurrentMonth = isSameMonth(day, currentDate);
            const isTodayDate = isToday(day);
            const hasItems = items.length > 0;

            return (
              <button
                key={day.toISOString()}
                type="button"
                disabled={!hasItems}
                onClick={() => setSelectedDay(day)}
                className={cn(
                  'min-h-[80px] rounded-lg border p-1 text-left transition-colors',
                  isCurrentMonth ? 'bg-background' : 'bg-muted/30',
                  isTodayDate && 'border-primary',
                  hasItems ? 'cursor-pointer hover:bg-muted/60' : 'cursor-default'
                )}
              >
                <div className={`text-xs font-medium ${isTodayDate ? 'text-primary' : ''}`}>
                  {format(day, 'd')}
                </div>
                <div className="space-y-1 mt-1">
                  {items.slice(0, 2).map((item) => (
                    <div
                      key={item.id}
                      className={`rounded px-1 py-0.5 text-[10px] text-white ${getStatusColor(
                        item.status
                      )} truncate`}
                    >
                      {item.title}
                    </div>
                  ))}
                  {items.length > 2 && (
                    <div className="text-[10px] text-muted-foreground">
                      +{items.length - 2} autre{items.length - 2 > 1 ? 's' : ''}
                    </div>
                  )}
                </div>
              </button>
            );
          })}
        </div>
      </CardContent>

      {/* Day detail dialog - opens on click for any day that has at least
          one article event, and lists everything for that day (not just
          the first two chips the grid cell has room to show). */}
      <Dialog open={selectedDay !== null} onOpenChange={(open) => !open && setSelectedDay(null)}>
        <DialogContent className="max-w-md">
          <DialogHeader>
            <DialogTitle className="capitalize">
              {selectedDay && format(selectedDay, 'EEEE d MMMM yyyy', { locale: fr })}
            </DialogTitle>
            <DialogDescription>
              {selectedDayItems.length} article{selectedDayItems.length > 1 ? 's' : ''} ce jour-là
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-2 max-h-[60vh] overflow-y-auto">
            {selectedDayItems.map((item) => (
              <Link
                key={item.id}
                href={`/admin/articles/${item.id}`}
                className="flex items-start gap-3 rounded-lg border p-3 text-sm hover:bg-muted transition-colors"
              >
                <FileText className="h-4 w-4 mt-0.5 flex-shrink-0 text-muted-foreground" />
                <div className="flex-1 min-w-0">
                  <p className="font-medium truncate">{item.title}</p>
                  <span
                    className={`inline-flex items-center gap-1 mt-1 rounded-full px-2 py-0.5 text-[11px] text-white ${getStatusColor(
                      item.status
                    )}`}
                  >
                    {STATUS_LABEL[item.status]}
                  </span>
                </div>
                <ExternalLink className="h-3.5 w-3.5 flex-shrink-0 text-muted-foreground mt-0.5" />
              </Link>
            ))}
          </div>
        </DialogContent>
      </Dialog>
    </Card>
  );
}
